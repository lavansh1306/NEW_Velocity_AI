# Example .env file for Velocity AI
# Copy this to .env and fill in your credentials

# ============================================
# JIRA CONFIGURATION
# ============================================

# LEGACY: Old single-tenant Jira configuration (still works for backward compatibility)
# You can remove these once you set up OAuth
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
JIRA_TEAM_FIELD_ID=

# NEW: Multi-tenant Jira OAuth 2.0 (recommended for SaaS)
# Create an OAuth app at https://developer.atlassian.com/console/myapps/
JIRA_OAUTH_CLIENT_ID=your-atlassian-oauth-client-id
JIRA_OAUTH_CLIENT_SECRET=your-atlassian-oauth-client-secret
JIRA_OAUTH_REDIRECT_URI=http://localhost:4000/api/jira/auth/callback

# ============================================
# ASANA CONFIGURATION
# ============================================
ASANA_TOKEN=your-asana-personal-access-token
ASANA_PROJECT_ID=your-asana-project-id

# ============================================
# MICROSOFT 365 OAUTH CONFIGURATION
# ============================================
# Create app at https://portal.azure.com/ → App registrations
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-client-secret
MS_REDIRECT_URI=http://localhost:4000/api/microsoft365/auth/callback

# ============================================
# HUBSPOT OAUTH CONFIGURATION
# ============================================
# Create app at https://app.hubspot.com/developer/
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:4000/oauth/hubspot/callback

# ============================================
# SESSION & SECURITY
# ============================================
# Generate a secure random string (min 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-very-secure-random-session-secret-min-32-chars

# ============================================
# SERVER CONFIGURATION
# ============================================
API_PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============================================
# PRODUCTION CONFIGURATION
# ============================================
# For production deployment, update these:
# NODE_ENV=production
# FRONTEND_URL=https://yourdomain.com
# MS_REDIRECT_URI=https://yourdomain.com/api/microsoft365/auth/callback
# HUBSPOT_REDIRECT_URI=https://yourdomain.com/oauth/hubspot/callback
# JIRA_OAUTH_REDIRECT_URI=https://yourdomain.com/api/jira/auth/callback
