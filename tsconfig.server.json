{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmitOnError": true,
    "moduleResolution": "node"
  },
  "include": ["server.ts", "api/**/*.ts", "src/api/**/*.ts"],
  "exclude": ["node_modules", "public", "api"]
}